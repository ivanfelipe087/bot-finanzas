# ==========================================
# CONFIGURACIÓN DEL BOT DE FINANZAS
# ==========================================

# Groq API (Gratis en: https://console.groq.com/keys)
GROQ_API_KEY=tu_groq_api_key_aqui

# Supabase (Proyecto -> Settings -> API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_key

# (Opcional) Números de WhatsApp autorizados con código de país (ej: 573001234567,573109876543)
# Si lo dejas vacío, cualquier persona que le escriba al bot puede usarlo.
ALLOWED_NUMBERS=
